{
	"name": "oh-my-lotr",
	"version": "1.3.0",
	"description": "The best AI agent harness for GitHub Copilot CLI — multi-agent orchestration with 11 specialized agents, 5 skills, and 3 MCP servers",
	"author": "howlowck",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howlowck/oh-my-lotr.git"
	},
	"keywords": [
		"copilot",
		"copilot-cli",
		"plugin",
		"agents",
		"ai",
		"llm",
		"orchestration"
	],
	"scripts": {
