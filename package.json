		"test:version": "node --test scripts/bump-version.test.mjs"
	},
	"devDependencies": {
		"handlebars": "4.7.8"
	},
	"files": [
		"plugin.json",
		"agents/",
		"skills/",
		"hooks.json",
		".mcp.json"
	]
}
